# ==============================================================================
# DocuLocker — Szablon Zmiennych Środowiskowych (.env.example)
# ==============================================================================
# UWAGA: Ten plik zawiera wyłącznie opisy parametrów konfiguracyjnych.
# ==============================================================================

# --- Tryb aplikacji & Środowisko ---
# Określa środowisko uruchomieniowe (development, staging, production)
EXPO_PUBLIC_APP_ENV=development

# Flaga włączająca szczegółowe logi diagnostyczne OCR i zapytań SQLite (true / false)
EXPO_PUBLIC_ENABLE_DEBUG_LOGS=true

# --- Konfiguracja Silnika OCR (On-Device Edge ML) ---
# Domyślny język parsowania heurystycznego (pl, en, de)
EXPO_PUBLIC_DEFAULT_OCR_LANGUAGE=pl

# Minimalny próg pewności (confidence threshold) dla dopasowań kwoty i daty (zakres: 0.0 - 1.0)
EXPO_PUBLIC_OCR_CONFIDENCE_THRESHOLD=0.65

# --- Reguły Domyślne Gwarancji & Powiadomień ---
# Domyślny czas trwania ustawowej rękojmi w miesiącach (domyślnie w Polsce: 24)
EXPO_PUBLIC_DEFAULT_WARRANTY_MONTHS=24

# Domyślne okno na ustawowy zwrot towaru w dniach dla zakupów na odległość (domyślnie: 14)
EXPO_PUBLIC_DEFAULT_RETURN_DAYS=14

# Liczba dni przed upływem gwarancji na wysłanie pierwszego powiadomienia ostrzegawczego
EXPO_PUBLIC_WARRANTY_ALERT_DAYS_BEFORE=30

# Godzina wysyłania lokalnych powiadomień w formacie 24h (HH:mm, np. 10:00)
EXPO_PUBLIC_NOTIFICATION_HOUR="10:00"

# --- Magazyn Danych & Baza SQLite ---
# Nazwa pliku bazy SQLite na urządzeniu
EXPO_PUBLIC_DATABASE_NAME=doculocker_local.db

# Wersja schematu migracji bazy danych
EXPO_PUBLIC_SCHEMA_VERSION=1

# Maksymalny rozmiar pojedynczego zdjęcia skanu w pikselach (dłuższa krawędź) przed kompresją
EXPO_PUBLIC_MAX_IMAGE_DIMENSION=1920

# Stopień kompresji JPEG (0.0 - 1.0, zalecane: 0.8 dla optymalnego stosunku jakości do wagi)
EXPO_PUBLIC_IMAGE_COMPRESSION_QUALITY=0.8

# --- Integracja Monetyzacji (Opcjonalne / RevenueCat) ---
# Publiczny klucz API RevenueCat dla Google Play (pusty w trybie czystego open-source)
# EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=goog_public_api_key_placeholder
