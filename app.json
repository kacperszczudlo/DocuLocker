{
  "expo": {
    "name": "DocuLocker",
    "slug": "doculocker",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "doculocker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "android": {
      "package": "app.doculocker.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "DocuLocker potrzebuje dostepu do zdjec, aby zalaczyc paragon.",
          "cameraPermission": "DocuLocker potrzebuje dostepu do aparatu, aby zrobic zdjecie paragonu."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
